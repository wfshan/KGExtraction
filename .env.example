# KGExtraction 环境变量配置
# 复制本文件为 .env 并填入真实值

# 阿里云百炼平台 API Key
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 大模型 API Base URL（兼容 OpenAI 标准）
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 后端服务端口
BACKEND_PORT=8000

# 前端服务端口
FRONTEND_PORT=5173

# 访问令牌（可选，强烈建议网络/团队部署时配置）
# 配置后所有 API 请求须携带 Authorization: Bearer <该值>；
# 前端在「系统配置 → 身份与访问」中填写同一令牌。
# KG_ACCESS_TOKEN=change-me-to-a-long-random-string
